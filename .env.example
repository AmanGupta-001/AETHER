# AETHER Environment Configuration
# LLM API Configuration (Supports Google Gemini or standard OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MODEL=gemini-flash-lite-latest

# Live Web Search (Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Calendar Integration (Service Account)
GOOGLE_AUTH_KEY=credentials.json
GOOGLE_CALENDAR_ID=your_email@gmail.com

# Gmail Integration (OAuth2)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID → Web application
# 3. Add http://localhost:3000/gmail/callback as redirect URI
# 4. Download JSON → save as core/gmail_oauth_client.json
# 5. Enable Gmail API + People API in your project
# Then visit http://localhost:3000/gmail/auth to link your account

# Server Port
PORT=3000
